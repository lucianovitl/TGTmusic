{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TGTmusic",
  "version": "1.0.3",
  "identifier": "com.tgtmusic",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://localhost:1420", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": { "windows": [ { "title": "TGTmusic", "width": 1200, "height": 800, "minWidth": 360, "minHeight": 500, "center": true, "resizable": true, "decorations": true } ], "security": { "csp": null } },
  "bundle": { "active": true, "targets": "all", "icon": ["icons/icon.ico", "icons/icon.svg"], "resources": ["resources/*"] },
  "plugins": { "sql": { "preload": ["sqlite:tgtmusic.db"] }, "updater": { "pubkey": "", "endpoints": ["https://github.com/prudenciodev/tgtmusic/releases/latest/download/latest.json"], "dialog": true }, "globalShortcut": { "shortcuts": { "MediaPlayPause": "play-pause", "MediaNextTrack": "next", "MediaPreviousTrack": "prev" } } }
}